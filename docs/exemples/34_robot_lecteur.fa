# Exemple 34 — Un robot qui lit une histoire à voix haute
# Notions : parler, découper, compter les mots, listes, joindre

soit histoire = "Il était une fois un petit robot nommé Fadi. Il aimait lire des histoires. Chaque soir, il lisait à voix haute pour ses amis. Les amis applaudissaient, et Fadi rougissait de fierté."

soit phrases = decouper(histoire, ". ")
soit total_mots = 0
soit plus_longue = ""

parler("Installez-vous, je vais vous lire une histoire.")
afficher "📖 Lecture en cours…"
afficher ""

soit numero = 0
pour chaque phrase dans phrases faire
  numero = numero + 1
  soit mots = decouper(phrase, " ")
  total_mots = total_mots + taille(mots)
  si taille(mots) > taille(decouper(plus_longue, " ")) alors
    plus_longue = phrase
  fin
  afficher "  " + numero + ". " + phrase
  parler(phrase)
fin

afficher ""
afficher "Phrases lues : " + taille(phrases)
afficher "Mots lus : " + total_mots
afficher "Phrase la plus longue : « " + plus_longue + " »"
parler("Fin de l'histoire. J'ai lu " + total_mots + " mots.")
