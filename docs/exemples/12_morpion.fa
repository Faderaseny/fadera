# Exemple 12 — Morpion (tic-tac-toe) : deux ordinateurs s'affrontent
# Notions : listes comme grille, fonctions, boucles, tableau des lignes gagnantes

soit lignes = [[0, 1, 2], [3, 4, 5], [6, 7, 8], [0, 3, 6], [1, 4, 7], [2, 5, 8], [0, 4, 8], [2, 4, 6]]

fonction case(g, i)
  renvoyer lireElement(g, i)
fin

fonction vainqueur(g)
  pour chaque l dans lignes faire
    soit a = case(g, lireElement(l, 0))
    si a != " " et a == case(g, lireElement(l, 1)) et a == case(g, lireElement(l, 2)) alors
      renvoyer a
    fin
  fin
  renvoyer ""
fin

fonction dessiner(g)
  afficher " " + case(g, 0) + " | " + case(g, 1) + " | " + case(g, 2)
  afficher "---+---+---"
  afficher " " + case(g, 3) + " | " + case(g, 4) + " | " + case(g, 5)
  afficher "---+---+---"
  afficher " " + case(g, 6) + " | " + case(g, 7) + " | " + case(g, 8)
fin

# Cherche une case qui permet à « joueur » de compléter une ligne (renvoie -1 s'il n'y en a pas)
fonction coup_gagnant(g, joueur)
  pour chaque l dans lignes faire
    soit vus = 0
    soit libre = -1
    pour chaque i dans l faire
      si case(g, i) == joueur alors
        vus = vus + 1
      sinon si case(g, i) == " " alors
        libre = i
      fin
    fin
    si vus == 2 et libre >= 0 alors
      renvoyer libre
    fin
  fin
  renvoyer -1
fin

# Stratégie : gagner si possible, sinon bloquer, sinon centre, sinon coins, sinon le reste
fonction choisir(g, joueur, adversaire)
  soit c = coup_gagnant(g, joueur)
  si c >= 0 alors
    renvoyer c
  fin
  c = coup_gagnant(g, adversaire)
  si c >= 0 alors
    renvoyer c
  fin
  pour chaque i dans [4, 0, 2, 6, 8, 1, 3, 5, 7] faire
    si case(g, i) == " " alors
      renvoyer i
    fin
  fin
  renvoyer -1
fin

soit grille = [" ", " ", " ", " ", " ", " ", " ", " ", " "]
soit joueur = "X"
soit autre = "O"
soit tour = 0
tantque tour < 9 et vainqueur(grille) == "" faire
  soit i = choisir(grille, joueur, autre)
  modifierElement(grille, i, joueur)
  afficher "Tour " + (tour + 1) + " : " + joueur + " joue en case " + (i + 1)
  soit tmp = joueur
  joueur = autre
  autre = tmp
  tour = tour + 1
fin

afficher ""
dessiner(grille)
afficher ""
si vainqueur(grille) == "" alors
  afficher "Match nul."
sinon
  afficher "Victoire de " + vainqueur(grille) + " !"
fin
