# Tests de la bibliothèque standard : lancez-les avec « 📚 Tests de la bibliothèque standard » (menu Applications)
# ou copiez un bloc « tester » dans vos programmes pour tester les vôtres : ils s'appuient sur les mêmes modules.
importer "std/dates"
importer "std/dictionnaire"
importer "std/ensemble"
importer "std/file"
importer "std/json"
importer "std/listes"
importer "std/maths"
importer "std/pile"
importer "std/regex"
importer "std/tas"
importer "std/textes"
importer "std/tri"

tester "std/pile : dernier entré, premier sorti"
  soit p = Pile()
  verifier(p.est_vide())
  p.empiler(1).empiler(2).empiler(3)
  verifier_egal(p.longueur(), 3)
  verifier_egal(p.sommet(), 3)
  verifier_egal(p.depiler(), 3)
  verifier_egal(p.en_liste(), [1, 2])
  verifier_egal(p.vider().longueur(), 0)
  verifier_erreur(() => p.depiler(), "Pile vide")
  verifier_erreur(() => p.sommet(), "Pile vide")
fin

tester "std/file : premier entré, premier sorti"
  soit f = File()
  f.enfiler("a").enfiler("b").enfiler("c")
  verifier_egal(f.tete(), "a")
  verifier_egal(f.defiler(), "a")
  verifier_egal(f.en_liste(), ["b", "c"])
  verifier_egal(f.longueur(), 2)
  pour i allantde 1 a 200 faire
    f.enfiler(i)
  fin
  soit somme_sortie = 0
  tantque f.longueur() > 1 faire
    somme_sortie = somme_sortie + 1
    f.defiler()
  fin
  verifier_egal(somme_sortie, 201)
  verifier_egal(f.defiler(), 200)
  verifier(f.est_vide())
  verifier_erreur(() => f.defiler(), "File vide")
fin

tester "std/dictionnaire : ordre d'insertion"
  soit d = Dictionnaire()
  d.definir("z", 1).definir(10, "dix").definir(2, "deux").definir("z", 9)
  verifier_egal(d.liste_cles(), ["z", "10", "2"])
  verifier_egal(d.liste_valeurs(), [9, "dix", "deux"])
  verifier_egal(d.obtenir(2), "deux")
  verifier_egal(d.obtenir_ou("absent", "repli"), "repli")
  verifier(d.possede(10))
  verifier_egal(d.supprimer(10), "dix")
  verifier_egal(d.longueur(), 2)
  verifier_egal(d.liste_paires(), [["z", 9], ["2", "deux"]])
  verifier_erreur(() => d.obtenir("absent"), "n'existe pas")
  verifier_erreur(() => d.supprimer("absent"), "n'existe pas")
fin

tester "std/ensemble : sans doublon"
  soit e = ensemble_depuis([3, 1, 3, "1", 2])
  verifier_egal(e.en_liste(), [3, 1, "1", 2])
  verifier(e.possede(1) et e.possede("1") et non e.possede(5))
  verifier_egal(e.union(ensemble_depuis([9, 1])).en_liste(), [3, 1, "1", 2, 9])
  verifier_egal(e.intersection(ensemble_depuis([1, 2, 7])).en_liste(), [1, 2])
  verifier_egal(e.difference(ensemble_depuis([1])).en_liste(), [3, "1", 2])
  e.exclure(3).exclure(42)
  verifier_egal(e.longueur(), 3)
fin

tester "std/tas : file de priorité"
  soit t = tas_min()
  pour chaque x dans [5, 3, 8, 1, 9, 2, 7] faire
    t.pousser(x)
  fin
  verifier_egal(t.premier(), 1)
  soit sortie = []
  tantque non t.est_vide() faire
    ajouter(sortie, t.extraire())
  fin
  verifier_egal(sortie, [1, 2, 3, 5, 7, 8, 9])
  verifier_egal(tas_max().pousser("m").pousser("z").extraire(), "z")
  soit par_age = Tas((a, b) => a.age - b.age)
  par_age.pousser({ nom: "Awa", age: 30 }).pousser({ nom: "Moussa", age: 20 })
  verifier_egal(par_age.extraire().nom, "Moussa")
  verifier_erreur(() => Tas(ordre_naturel).extraire(), "Tas vide")
fin

tester "std/tri : tris"
  soit l = [5, 2, 9, 1, 5, 6]
  soit croissant = [1, 2, 5, 5, 6, 9]
  verifier_egal(tri_fusion(l, ordre_naturel), croissant)
  verifier_egal(tri_rapide(l, ordre_naturel), croissant)
  verifier_egal(tri_insertion(l, ordre_naturel), croissant)
  verifier_egal(trier_decroissant(l), [9, 6, 5, 5, 2, 1])
  verifier_egal(l, [5, 2, 9, 1, 5, 6], "la liste d'origine ne change pas")
  verifier(est_trie(croissant) et non est_trie(l))
  soit gens = [{ n: "a", age: 30, v: "x" }, { n: "b", age: 20, v: "y" }, { n: "c", age: 30, v: "a" }]
  verifier_egal(transformer(trier_multi(gens, [g => g.age, g => g.v]), g => g.n), ["b", "c", "a"])
fin

tester "std/tri : recherches"
  soit s = [1, 2, 5, 5, 6, 9]
  verifier_egal(recherche_binaire(s, 6), 4)
  verifier_egal(recherche_binaire(s, 7), -1)
  verifier_egal(borne_inf(s, 5), 2)
  verifier_egal(borne_sup(s, 5), 4)
  verifier_egal(indice_de([4, 8, 15], 15), 2)
  verifier_egal(plus_petits(s, 2), [1, 2])
  verifier_egal(plus_grands(s, 3), [9, 6, 5])
  verifier_egal(minimum_par([{ a: 3 }, { a: 1 }], g => g.a), { a: 1 })
  verifier_egal(grouper_par([1, 2, 3, 4], x => x % 2), { "1": [1, 3], "0": [2, 4] })
  verifier_erreur(() => minimum_par([], x => x), "vide")
fin

tester "std/json : outils"
  verifier_egal(json_aplatir({ a: { b: [1, { c: 2 }] }, d: "x" }), { "a.b[0]": 1, "a.b[1].c": 2, d: "x" })
  verifier_egal(json_profondeur({ a: { b: [1] } }), 3)
  verifier_egal(json_selectionner([{ a: 1, b: 2 }, { a: 3, b: 4 }], ["b"]), [{ b: 2 }, { b: 4 }])
  verifier_egal(json_lire_ou("{oups", "repli"), "repli")
  verifier_egal(json_lire_ou("[1, 2]", "repli"), [1, 2])
  verifier(json_egal({ a: 1 }, { a: 1 }) et non json_egal({ a: 1 }, { a: 2 }))
  verifier_egal(json_compact({ a: [1, 2] }), "{\"a\":[1,2]}")
fin

tester "std/regex : validation et extraction"
  verifier(est_courriel("awa.diop@exemple.sn") et non est_courriel("awa@"))
  verifier(est_url("https://exemple.sn/page?x=1") et non est_url("exemple.sn"))
  verifier(est_entier("-12") et non est_entier("1.5"))
  verifier(est_telephone("+221 77 123 45 67") et non est_telephone("12"))
  verifier_egal(extraire_nombres("a 3, -4.5 et 10"), [3, -4.5, 10])
  verifier_egal(extraire_mots("Été chaud, déjà là !"), ["Été", "chaud", "déjà", "là"])
  verifier_egal(extraire_courriels("x a@b.fr y c.d@e.org"), ["a@b.fr", "c.d@e.org"])
  verifier_egal(reduire_espaces("  a   b  c "), "a b c")
  verifier_egal(compter_motif("abab", "ab"), 2)
  verifier_egal(remplacer_chaque("a1b22", "\\d+", n => "<" + (nombre(n) * 2) + ">"), "a<2>b<44>")
fin

tester "std/dates : calendrier"
  soit ts = date_creer(2026, 10, 22)
  verifier_egal(date_longue(ts), "jeudi 22 octobre 2026")
  verifier_egal(date_formater(ajouter_jours(ts, 10), "AAAA-MM-JJ"), "2026-11-01")
  verifier_egal(date_formater(fin_du_mois(ts), "AAAA-MM-JJ"), "2026-10-31")
  verifier_egal(date_formater(debut_du_mois(ts), "AAAA-MM-JJ"), "2026-10-01")
  verifier(est_jour_ouvre(ts) et non est_week_end(ts) et est_week_end(date_creer(2026, 10, 24)))
  verifier_egal(jours_entre(ts, date_creer(2026, 10, 25)), 3)
  verifier_egal(jours_ouvres_entre(date_creer(2026, 10, 19), date_creer(2026, 10, 26)), 5)
  verifier_egal(date_formater(ajouter_jours_ouvres(ts, 3), "AAAA-MM-JJ"), "2026-10-27")
  verifier_egal(date_formater(prochain_jour(ts, "lundi"), "AAAA-MM-JJ"), "2026-10-26")
  verifier(meme_jour(ts, ts + 5000))
  verifier_egal(duree_texte(93784000), "1 j 2 h 3 min 4 s")
  verifier_egal(taille(calendrier(2026, 10)), 122)
  verifier_erreur(() => prochain_jour(ts, "zzz"), "nom de jour inconnu")
fin

tester "std/maths : arithmétique et statistiques"
  verifier_egal(pgcd(12, 18), 6)
  verifier_egal(ppcm(4, 6), 12)
  verifier_egal(factorielle(5), 120)
  verifier_egal(fibonacci(10), 55)
  verifier(est_premier(97) et non est_premier(91))
  verifier_egal(somme([1, 2, 3]) + produit([2, 3, 4]), 30)
  verifier_egal(moyenne([1, 2, 3, 4]), 2.5)
  verifier_egal(mediane([5, 1, 3]), 3)
  verifier_egal(mediane([1, 2, 3, 4]), 2.5)
  verifier_egal(variance([2, 4, 4, 4, 5, 5, 7, 9]), 4)
  verifier_egal(ecart_type([2, 4, 4, 4, 5, 5, 7, 9]), 2)
  verifier_egal(combinaisons(5, 2), 10)
  verifier_egal(combinaisons(50, 25), 126410606437752)
  verifier_egal(arrangements(5, 2), 20)
  verifier_egal(puissance_mod(2, 100, 1000007), 698635)
  verifier_egal(racine_entiere(99), 9)
  verifier(est_carre_parfait(144) et non est_carre_parfait(145))
  verifier_egal(diviseurs(36), [1, 2, 3, 4, 6, 9, 12, 18, 36])
  verifier_egal(transposer([[1, 2, 3], [4, 5, 6]]), [[1, 4], [2, 5], [3, 6]])
  verifier_egal(produit_matrices([[1, 2], [3, 4]], [[5, 6], [7, 8]]), [[19, 22], [43, 50]])
  verifier_erreur(() => mediane([]), "liste est vide")
fin

tester "std/textes et std/listes"
  verifier(est_vide("   ") et non est_vide("a"))
  verifier_egal(tronquer("bonjour", 3), "bo…")
  verifier_egal(inverser_texte("abc"), "cba")
  verifier_egal(compter_occurrences("banana", "an"), 2)
  verifier_egal(premier([7, 8, 9]), 7)
  verifier_egal(dernier([7, 8, 9]), 9)
  verifier_egal(prendre([1, 2, 3, 4], 2), [1, 2])
  verifier_egal(sauter([1, 2, 3, 4], 2), [3, 4])
  verifier_egal(compter_si([1, 2, 3, 4], x => x > 2), 2)
  verifier_egal(partitionner([1, 2, 3, 4], x => x % 2 == 0), [[2, 4], [1, 3]])
  verifier_erreur(() => premier([]), "hors limites")
fin
